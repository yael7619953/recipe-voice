# =============================================================================
# Server
# =============================================================================
PORT=5000

# =============================================================================
# Database
# =============================================================================
# Local default: mongodb://localhost:27017/recipeDB (see config/db.js)
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/recipeDB
MONGO_URI=mongodb://localhost:27017/recipeDB

# =============================================================================
# Auth (JWT)
# =============================================================================
JWT_SECRET=change-me-to-a-long-random-string

# =============================================================================
# Google OAuth (Passport)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Client (Angular)
# =============================================================================
# Used for OAuth redirect: {CLIENT_URL}/auth/oauth-callback?token=<JWT>
CLIENT_URL=http://localhost:4200

# =============================================================================
# AI / Voice (LLM providers; Whisper STT when voice is added)
# =============================================================================
# Active provider: gemini (default) | groq
AI_PROVIDER=groq

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Groq — https://console.groq.com (used when AI_PROVIDER=groq)
GROQ_API_KEY=
# Optional override (default: meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
